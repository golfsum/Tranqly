{
  "name": "tranqly",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-next.mjs dev",
    "build": "node scripts/run-next.mjs build",
    "start": "node scripts/run-next.mjs start",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/generate-brand-assets.ps1 -Source public/tranqly_logo.png",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:build:ios": "npm --prefix apps/mobile run build:ios",
    "mobile:submit:ios": "npm --prefix apps/mobile run submit:ios",
    "screenshots:app-store:capture": "node scripts/capture-app-store-sources.mjs",
    "screenshots:app-store": "node scripts/generate-app-store-screenshots.mjs",
    "test:visual:landing": "playwright test",
    "test:visual:app": "playwright test --config playwright.mobile.config.ts",
    "test:visual:app:update": "playwright test --config playwright.mobile.config.ts --update-snapshots",
    "test:landing": "playwright test",
    "test:app": "playwright test --config playwright.mobile.config.ts",
    "test:all": "npm run test:landing && npm run test:app"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "firebase-admin": "13.10.0",
    "framer-motion": "^11.15.0",
    "next": "^14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.5.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
