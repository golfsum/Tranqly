rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Safe troubleshooting metadata only. No raw reflection text belongs here.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Private app state can include reflection content. Admins cannot read it by default.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Safe reflection processing metadata only.
      match /metadata/{docId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }

      match /errors/{errorId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isOwner(uid);
        allow update: if isAdmin();
      }

      match /notificationSettings/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /sanctuaryUnlocks/{themeId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Duplicated safe error metadata for admin queries.
    match /adminErrors/{errorId} {
      allow read, update: if isAdmin();
      allow create: if signedIn();
      allow delete: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAdmin() ||
          (signedIn() &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);
        allow create: if isAdmin() ||
          (signedIn() &&
            get(/databases/$(database)/documents/supportTickets/$(ticketId)).data.uid == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // Operational collections are visible only to authenticated admins.
    // Writes are handled by the app's existing logging paths, not the dashboard.
    match /adminAiUsage/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminAiUserUsage/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiUsageLogs/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /siteAnalytics/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /waitlistSignups/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
