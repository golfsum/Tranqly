{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://tranqly.app",
        "EXPO_PUBLIC_FIREBASE_PROJECT_ID": "tranqly-e91fb"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
