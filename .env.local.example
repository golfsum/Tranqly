# AI Coach and voice transcription, server-side
# Get a key at https://console.groq.com/home.
# Without it, the app falls back to the built-in local coach.
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Site controls
NEXT_PUBLIC_SITE_URL=https://tranqly.com
NEXT_PUBLIC_TRANQLY_COMING_SOON=true

# Protect /admin with Firebase email/password auth.
# Comma-separated list if you want more than one admin.
NEXT_PUBLIC_ADMIN_EMAILS=

# Firebase, client-side and safe to expose
# Firebase Console > Project settings > Your apps > Web app config.
# Enable Google sign-in under Authentication, and create a Firestore DB.
# Leave blank to run in local-only mode with device storage only.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Stripe, server-side
# Without these, the premium upgrade runs in demo mode with instant unlock.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
